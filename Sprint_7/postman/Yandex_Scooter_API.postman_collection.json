  "item": [
    {
      "name": "Courier — create",
      "item": [
        {
          "name": "Create unique courier",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const suffix = Date.now() + '_' + Math.random().toString(36).slice(2, 10);",
                  "pm.collectionVariables.set('courierLogin', 'postman_' + suffix);",
                  "pm.collectionVariables.set('courierPassword', 'password_' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Body is ok true', () => pm.expect(pm.response.json()).to.eql({ok: true}));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{courierLogin}}\",\n  \"password\": \"{{courierPassword}}\",\n  \"firstName\": \"Postman\"\n}"
            },
            "url": "{{baseUrl}}/courier"
          }
        },
        {
          "name": "Create duplicate courier",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error message exists', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{courierLogin}}\",\n  \"password\": \"{{courierPassword}}\",\n  \"firstName\": \"Postman\"\n}"
            },
            "url": "{{baseUrl}}/courier"
          }
        },
        {
          "name": "Create courier without login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error message exists', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
