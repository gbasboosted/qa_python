    {
      "name": "Orders — create",
      "item": [
        {
          "name": "Create order — BLACK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Body contains track', () => pm.expect(body.track).to.be.a('number'));",
                  "pm.collectionVariables.set('track', body.track);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Иван\",\n  \"lastName\": \"Тестов\",\n  \"address\": \"Москва, Тестовая улица, 1\",\n  \"metroStation\": 4,\n  \"phone\": \"+79990000000\",\n  \"rentTime\": 3,\n  \"deliveryDate\": \"2026-09-20\",\n  \"comment\": \"Postman manual check\",\n  \"color\": [\"BLACK\"]\n}"
            },
            "url": "{{baseUrl}}/orders"
          }
        }
      ]
    },
    {
      "name": "Orders — read and accept",
      "item": [
        {
          "name": "Get orders list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('orders is an array', () => pm.expect(pm.response.json().orders).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders?limit=1&page=0"
          }
        },
        {
          "name": "Get order by track",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Body contains order', () => pm.expect(body.order).to.be.an('object'));",
                  "pm.collectionVariables.set('orderId', body.order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/track?t={{track}}"
          }
        },
        {
          "name": "Get order without track",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error message exists', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/track"
          }
        },
        {
          "name": "Accept order without courierId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error message exists', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/orders/accept/{{orderId}}"
          }
        },
        {
          "name": "Accept order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body is ok true', () => pm.expect(pm.response.json()).to.eql({ok: true}));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/orders/accept/{{orderId}}?courierId={{courierId}}"
          }
        }
      ]
    },
